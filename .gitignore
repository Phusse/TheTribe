# =========================
# TheTribe Project .gitignore
# =========================

# -----------------
# .NET / C# Backend
# -----------------

# Build outputs
bin/
obj/
out/

# NuGet packages
*.nupkg
**/packages/*
!**/packages/build/

# User-specific files
*.user
*.userosscache
*.suo
*.sln.docstates

# Build results
[Dd]ebug/
[Rr]elease/
x64/
x86/
build/
bld/

# Visual Studio
.vs/
*.rsuser
*.sln.docstates
*.csproj.user
*.vspx
*.vspscc
*.vssscc

# Rider IDE
.idea/

# Resharper
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# -----------------
# Sensitive Configuration Files
# -----------------

# IMPORTANT: These files contain secrets (DB passwords, JWT secrets, API keys)
appsettings.Development.json
appsettings.Production.json
appsettings.Local.json
secrets.json
*.secrets.json

# Environment files
.env
.env.*
!.env.example

# -----------------
# Node.js / Next.js Frontend
# -----------------

# Dependencies
node_modules/
.pnp/
.pnp.js

# Next.js build output
.next/
out/

# Next.js cache
.cache/

# Testing
coverage/

# Production build
build/
dist/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -----------------
# OS Generated Files
# -----------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# -----------------
# IDE / Editor Files
# -----------------

# JetBrains
*.iml
*.ipr
*.iws
.idea/

# Sublime Text
*.sublime-project
*.sublime-workspace

# -----------------
# Temporary & Cache Files
# -----------------

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# Log files
*.log

# SQLite databases (if used for local development)
*.db
*.sqlite
*.sqlite3

# -----------------
# Testing & Coverage
# -----------------

# Test results
TestResults/
*.trx
coverage/
*.coverage
.coveragexml

# -----------------
# Other
# -----------------

# Azure Functions
local.settings.json

# Terraform
*.tfstate
*.tfstate.*
.terraform/

# Docker
docker-compose.override.yml

# Certificates
*.pfx
*.p12
*.pem
*.key
*.crt
!*.crt.example

# HTTP test files with secrets (optional - uncomment if your .http files contain secrets)
# *.http
