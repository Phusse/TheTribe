@host = http://localhost:5200

# ==========================================
# 1. AUTHENTICATION & SETUP
# ==========================================

### 1.1 Register User A (Admin/Main)
# @name registerA
POST {{host}}/api/auth/register
Content-Type: application/json

{
    "firstName": "Alice",
    "lastName": "Admin",
    "email": "alice@tribe.com",
    "password": "Password123!"
}

### 1.2 Login User A
# @name loginA
POST {{host}}/api/auth/login
Content-Type: application/json

{
    "email": "alice@tribe.com",
    "password": "Password123!"
}

@tokenA = {{loginA.response.body.token}}
@userIdA = {{loginA.response.body.id}}


### 1.3 Register User B (Bob - Friend)
# @name registerB
POST {{host}}/api/auth/register
Content-Type: application/json

{
    "firstName": "Bob",
    "lastName": "Builder",
    "email": "bob@tribe.com",
    "password": "Password123!"
}

### 1.4 Login User B
# @name loginB
POST {{host}}/api/auth/login
Content-Type: application/json

{
    "email": "bob@tribe.com",
    "password": "Password123!"
}

@tokenB = {{loginB.response.body.token}}
@userIdB = {{loginB.response.body.id}}


### 1.5 Register User C (Charlie - Stranger)
# @name registerC
POST {{host}}/api/auth/register
Content-Type: application/json

{
    "firstName": "Charlie",
    "lastName": "Chaplin",
    "email": "charlie@tribe.com",
    "password": "Password123!"
}

### 1.6 Login User C
# @name loginC
POST {{host}}/api/auth/login
Content-Type: application/json

{
    "email": "charlie@tribe.com",
    "password": "Password123!"
}

@tokenC = {{loginC.response.body.token}}
@userIdC = {{loginC.response.body.id}}


### 1.7 Negative Auth: Wrong Password
POST {{host}}/api/auth/login
Content-Type: application/json

{
    "email": "alice@tribe.com",
    "password": "WrongPassword!"
}
# Expected: 401 Unauthorized


# ==========================================
# 2. LIVE SESSIONS (CRUD)
# ==========================================

### 2.1 Create Session (User A)
# @name createSession
POST {{host}}/api/LiveSession
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
    "title": "Weekly Q&A",
    "description": "General Q&A for the community",
    "meetingUrl": "https://zoom.us/j/111222333",
    "scheduledAt": "2026-06-01T20:00:00Z"
}

@sessionId = {{createSession.response.body.id}}


### 2.2 Get All Sessions
GET {{host}}/api/LiveSession
Authorization: Bearer {{tokenA}}


### 2.3 Update Session (User A)
# @name updateSession
PUT {{host}}/api/LiveSession/{{sessionId}}
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
    "title": "Weekly Q&A - Rescheduled",
    "description": "Moved to later time",
    "meetingUrl": "https://zoom.us/j/111222333",
    "scheduledAt": "2026-06-01T21:00:00Z"
}


### 2.4 Negative: Delete Session as User B (Should Fail)
DELETE {{host}}/api/LiveSession/{{sessionId}}
Authorization: Bearer {{tokenB}}
# Expected: 403 Forbidden (Logic allowing only Creator/Admin to delete is assumed)


### 2.5 Delete Session (User A)
DELETE {{host}}/api/LiveSession/{{sessionId}}
Authorization: Bearer {{tokenA}}


# ==========================================
# 3. SOCIAL GRAPH
# ==========================================

### 3.1 Get Profile of User B (as User A)
GET {{host}}/api/Users/{{userIdB}}
Authorization: Bearer {{tokenA}}


### 3.2 Send Connection Request: A -> B
# @name requestAB
POST {{host}}/api/Connection/request
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
    "targetUserId": "{{userIdB}}"
}


### 3.3 Check Pending Requests (as User B)
# @name getPendingB
GET {{host}}/api/Connection/pending
Authorization: Bearer {{tokenB}}

# Using JSONPath to extract the first pending connection ID
# Note: This variable usage depends on the specific VS Code extension version,
# if it fails, manually copy the ID from the response above.
@connectionId_AB = {{getPendingB.response.body.$[0].id}}


### 3.4 Accept Request (User B accepts A)
PUT {{host}}/api/Connection/{{connectionId_AB}}/respond
Authorization: Bearer {{tokenB}}
Content-Type: application/json

{
    "status": 1
}
# Status 1 = Accepted


### 3.5 List Connections (User A)
# Should now show Bob
GET {{host}}/api/Connection
Authorization: Bearer {{tokenA}}


### 3.6 Reject Scenario: C -> A
# @name requestCA
POST {{host}}/api/Connection/request
Authorization: Bearer {{tokenC}}
Content-Type: application/json

{
    "targetUserId": "{{userIdA}}"
}

### 3.7 Reject Request (User A rejects C)
# First get pending
# @name getPendingA
GET {{host}}/api/Connection/pending
Authorization: Bearer {{tokenA}}

@connectionId_CA = {{getPendingA.response.body.$[0].id}}

PUT {{host}}/api/Connection/{{connectionId_CA}}/respond
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
    "status": 2
}
# Status 2 = Rejected


# ==========================================
# 4. CHAT, PRIVACY & DRAFTS
# ==========================================

### 4.1 Send Global Message (User C)
POST {{host}}/api/Chat/send
Authorization: Bearer {{tokenC}}
Content-Type: application/json

{
    "content": "Hello! I am Charlie, I am new here."
}

### 4.2 Send Private Message: A -> B
POST {{host}}/api/Chat/send
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
    "content": "Hey Bob, good to see you connected!",
    "receiverId": "{{userIdB}}"
}

### 4.3 Check History (User A)
# Should see: Global from C + Private sent to B
GET {{host}}/api/Chat/history
Authorization: Bearer {{tokenA}}

### 4.4 Check History (User B)
# Should see: Global from C + Private received from A
GET {{host}}/api/Chat/history
Authorization: Bearer {{tokenB}}

### 4.5 Check History (User C)
# Should see: ONLY Global (Should NOT see A->B private chat)
GET {{host}}/api/Chat/history
Authorization: Bearer {{tokenC}}


### 4.6 Drafts: Save Draft (User A)
POST {{host}}/api/Chat/draft
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
    "content": "This is a work in progress message..."
}

### 4.7 Drafts: Retrieve Draft (User A)
GET {{host}}/api/Chat/draft
Authorization: Bearer {{tokenA}}

### 4.8 Drafts: Ensure B has no draft
GET {{host}}/api/Chat/draft
Authorization: Bearer {{tokenB}}
# Expected: 204 No Content


# ==========================================
# 5. CHAT ROOMS & ROLES (Admin Flow)
# ==========================================

### 5.0 FIX Super Admin Password (ONE-TIME - Run this first!)
# Call this ONCE if super admin login fails with Base64 error
POST {{host}}/api/auth/fix-superadmin
Content-Type: application/json

### 5.1 Login as Super Admin (Seeded on Startup)
# @name loginSuper
POST {{host}}/api/auth/login
Content-Type: application/json

{
    "email": "superadmin@tribe.com",
    "password": "Password123!"
}

@tokenSuper = {{loginSuper.response.body.token}}


### 5.2 Promote Alice to Admin (Super Admin -> A)
PUT {{host}}/api/Users/{{userIdA}}/role
Authorization: Bearer {{tokenSuper}}
Content-Type: application/json

{
    "role": 1
}
# 1 = Admin, 2 = SuperAdmin


### 5.3 Create Chat Room (User A - Now Admin)
# @name createRoom
POST {{host}}/api/ChatRoom
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
    "name": "Secret Strategy Room",
    "description": "Top secret discussions"
}

@roomId = {{createRoom.response.body.id}}


# ==========================================
# 6. USER MANAGEMENT (Super Admin Actions)
# ==========================================

### 6.1 List All Users (Super Admin)
GET {{host}}/api/Users
Authorization: Bearer {{tokenSuper}}


### 6.2 Suspend User B (Bob)
# @name suspendBob
PUT {{host}}/api/Users/{{userIdB}}/status
Authorization: Bearer {{tokenSuper}}
Content-Type: application/json

{
    "isActive": false
}


### 6.3 Verify Bob Cannot Login
POST {{host}}/api/auth/login
Content-Type: application/json

{
    "email": "bob@tribe.com",
    "password": "Password123!"
}
# Expected: 401 Unauthorized (Suspended)


### 6.4 Reactivate User B (Bob)
PUT {{host}}/api/Users/{{userIdB}}/status
Authorization: Bearer {{tokenSuper}}
Content-Type: application/json

{
    "isActive": true
}


### 6.5 Verify Bob Can Login Now
POST {{host}}/api/auth/login
Content-Type: application/json

{
    "email": "bob@tribe.com",
    "password": "Password123!"
}
# Expected: 200 OK


### 6.6 Delete User C (Charlie)
DELETE {{host}}/api/Users/{{userIdC}}
Authorization: Bearer {{tokenSuper}}


### 6.7 Verify Charlie is Gone (List Users)
GET {{host}}/api/Users
Authorization: Bearer {{tokenSuper}}
# Expected: Charlie missing from list


### 5.3 Attempt Join by Charlie (Stranger) - Should list 0 rooms
GET {{host}}/api/ChatRoom
Authorization: Bearer {{tokenC}}
# Expected: Empty List


### 5.4 Add Member Charlie to Room (User A adds C)
POST {{host}}/api/ChatRoom/{{roomId}}/members
Authorization: Bearer {{tokenA}}
Content-Type: application/json

{
    "userId": "{{userIdC}}"
}


### 5.5 Charlie Checks Rooms (Should now see it)
GET {{host}}/api/ChatRoom
Authorization: Bearer {{tokenC}}


### 5.6 Send Message to Room (Charlie)
POST {{host}}/api/Chat/send
Authorization: Bearer {{tokenC}}
Content-Type: application/json

{
    "content": "Hello Secret Room!",
    "chatRoomId": "{{roomId}}"
}


### 5.7 Check History (User A - Member of Room)
# Should see message from Charlie in the room
GET {{host}}/api/Chat/history
Authorization: Bearer {{tokenA}}


### 5.8 Check History (User B - Not a Member)
# Should NOT see the message
GET {{host}}/api/Chat/history
Authorization: Bearer {{tokenB}}
